{
  "master_spacing_mm": 8,
  "output_filename": "handwriting_practice.png",
  "page_layout": [
    {
      "name": "Manuscript Practice",
      "region_rect": [0, 0, 1.0, 0.5],
      "template": "manuscript",
      "spacing_mm": 9,
      "kwargs": { 
        "line_width_px": 0.5,
        "midline_style": "dashed"
      }
    },
    {
      "name": "French Ruled Practice",
      "region_rect": [0, 0.5, 1.0, 0.5],
      "template": "french_ruled",
      "spacing_mm": 2,
      "kwargs": { "line_width_px": 0.5 }
    }
  ]
}
