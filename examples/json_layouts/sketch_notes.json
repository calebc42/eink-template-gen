    },
    {
      "name": "Notes Area",
      "region_rect": [
        0,
        0.65,
        1.0,
        0.35
      ],
      "template": "lined",
      "spacing_mm": 7,
      "kwargs": {
        "line_width_px": 0.5
      }
    }
  ]
}